{
	"name": "data2resilience",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"typesafe-i18n": "typesafe-i18n",
		"build:test": "svelte-kit sync && IS_DOCKER=1 vite build --mode test && node scripts/remap-server-sourcemaps.mjs",
		"test": "pnpm test:unit && pnpm build:test && pnpm test:e2e && pnpm coverage",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:record": "RECORD=1 playwright test",
		"test:e2e:docker": "scripts/docker.sh sh -c 'pnpm build:test && pnpm test:e2e \"$@\"' --",
		"test:integration": "playwright test -c playwright.integration.config.ts",
		"coverage": "node scripts/coverage.mjs"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@12.15.0",
	"devDependencies": {
		"@ampproject/remapping": "^2.3.0",
		"@ctrl/tinycolor": "^4.2.1",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "1.64.1",
		"@svelte-put/shortcut": "^4.2.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/match-sorter-utils": "^9.2.6",
		"@tanstack/svelte-query": "^6.3.6",
		"@tanstack/svelte-query-devtools": "^6.3.6",
		"@tanstack/svelte-table": "^9.3.1",
		"@tanstack/table-core": "^9.3.1",
		"@types/d3-array": "^3.2.2",
		"@types/d3-interpolate": "^3.0.4",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/eslint": "^9.6.1",
		"@types/topojson-client": "^3.1.5",
		"@vitest/browser": "5.0.5",
		"@vitest/browser-playwright": "5.0.5",
		"@vitest/coverage-v8": "5.0.5",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"d3-array": "^3.2.4",
		"d3-interpolate": "^3.0.1",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.1.0",
		"date-fns": "^4.4.0",
		"es-toolkit": "^1.53.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"html2canvas-pro": "^2.5.2",
		"layerchart": "^2.9.1",
		"maplibre-gl": "^6.16.0",
		"mode-watcher": "^1.1.0",
		"monocart-coverage-reports": "^3.1.0",
		"playwright": "1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shepherd.js": "^15.3.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-maplibre": "^2.0.1",
		"svelte-multiselect": "^11.8.0",
		"svelte-range-slider-pips": "^4.1.1",
		"svelte-seo": "^2.0.0",
		"sveltekit-search-params": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"topojson-client": "^3.1.0",
		"typesafe-i18n": "^5.27.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "3.1.0",
		"vitest-monocart-coverage": "^5.0.0",
		"workbox-window": "^7.4.1",
		"zod": "^4.6.7",
		"zod-validation-error": "^5.0.0"
	},
	"type": "module",
	"dependencies": {
		"@kitql/handles": "^0.4.2",
		"@sentry/sveltekit": "^11.9.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#i18n/*": "./src/i18n/*"
	}
}
